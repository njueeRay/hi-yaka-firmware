  <diagram id="yaka-runtime" name="02 启动、事件与任务并发">
    <mxGraphModel adaptiveColors="auto" dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="rt-title" value="&lt;b&gt;运行时控制面、事件汇聚与 FreeRTOS 任务&lt;/b&gt;&lt;br&gt;粗实线为当前路径；橙色虚线为 PH2/PH3 目标路径" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="1260" height="60" as="geometry"/></mxCell>
        <mxCell id="boot-lane" value="启动顺序" style="swimlane;horizontal=0;startSize=110;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="520" height="1180" as="geometry"/></mxCell>
        <mxCell id="boot-main" value="&lt;b&gt;app_main()&lt;/b&gt;&lt;br&gt;main/main.cc&lt;br&gt;NVS init / 必要时擦除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="boot-lane"><mxGeometry x="140" y="45" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="boot-board" value="&lt;b&gt;Board::GetInstance()&lt;/b&gt;&lt;br&gt;DECLARE_BOARD → HiYakaV3Board 构造&lt;br&gt;Flash/heap 日志 → I²C → PCA9557 安全态 → 五地址探测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="boot-lane"><mxGeometry x="140" y="165" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="boot-init" value="&lt;b&gt;Application::Initialize()&lt;/b&gt;&lt;br&gt;main/application.cc&lt;br&gt;Display::SetupUI → AudioService::Initialize/Start&lt;br&gt;注册音频/状态/网络回调 → StartNetwork" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="boot-lane"><mxGeometry x="140" y="330" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="boot-run" value="&lt;b&gt;Application::Run()&lt;/b&gt;&lt;br&gt;主任务优先级 10；永不返回&lt;br&gt;xEventGroupWaitBits → 串行处理事件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="boot-lane"><mxGeometry x="140" y="505" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="boot-activation" value="&lt;b&gt;activation task&lt;/b&gt;&lt;br&gt;栈 8192 / 优先级 2&lt;br&gt;Assets → OTA check/activation → Protocol init" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="boot-lane"><mxGeometry x="140" y="650" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="boot-product" value="&lt;b&gt;计划：ProductController 启动&lt;/b&gt;&lt;br&gt;读取 CapabilityHealth&lt;br&gt;决定配网 / 首页 / 离线 / 恢复&lt;br&gt;不绕过 Application 和 DeviceStateMachine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="boot-lane"><mxGeometry x="140" y="805" width="320" height="115" as="geometry"/></mxCell>
        <mxCell id="boot-rule" value="&lt;b&gt;启动安全约束&lt;/b&gt;&lt;br&gt;PA、背光、RGB、马达默认关闭&lt;br&gt;单个非关键外设失败必须降级&lt;br&gt;不得用重启循环掩盖失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="boot-lane"><mxGeometry x="140" y="980" width="320" height="110" as="geometry"/></mxCell>

        <mxCell id="event-lane" value="主任务事件汇聚" style="swimlane;horizontal=0;startSize=110;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="100" width="760" height="1180" as="geometry"/></mxCell>
        <mxCell id="event-group" value="&lt;b&gt;Application EventGroup&lt;/b&gt;&lt;br&gt;MAIN_EVENT_SCHEDULE / SEND_AUDIO / WAKE_WORD / VAD / ERROR&lt;br&gt;NETWORK_CONNECTED / DISCONNECTED / TOGGLE_CHAT / START/STOP_LISTENING&lt;br&gt;STATE_CHANGED / PLAYBACK_DRAINED / CLOCK_TICK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="event-lane"><mxGeometry x="140" y="45" width="560" height="125" as="geometry"/></mxCell>
        <mxCell id="event-loop" value="&lt;b&gt;主事件循环：唯一上游应用变更上下文&lt;/b&gt;&lt;br&gt;错误 → 网络 → 激活 → 状态变化 → 播放排空 → 用户动作 → 音频发送 → 定时&lt;br&gt;状态改变统一调用 Application::SetDeviceState()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="event-lane"><mxGeometry x="140" y="225" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="schedule" value="&lt;b&gt;Application::Schedule()&lt;/b&gt;&lt;br&gt;mutex_ + main_tasks_ (std::deque)&lt;br&gt;跨任务回调先排队，再由 MAIN_EVENT_SCHEDULE 串行执行&lt;br&gt;PH2 需定义容量/拒绝策略，避免无界积压" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="event-lane"><mxGeometry x="140" y="385" width="560" height="120" as="geometry"/></mxCell>
        <mxCell id="state-change" value="&lt;b&gt;DeviceStateMachine&lt;/b&gt;&lt;br&gt;atomic current_state + 转换表 + listener&lt;br&gt;listener 只置 MAIN_EVENT_STATE_CHANGED；UI/LED/Audio 在主任务响应" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="event-lane"><mxGeometry x="140" y="555" width="560" height="100" as="geometry"/></mxCell>
        <mxCell id="product-queue" value="&lt;b&gt;计划：ProductEventQueue&lt;/b&gt;&lt;br&gt;固定容量；事件带来源、时间戳、关联 ID、超时和丢弃指标&lt;br&gt;ISR/驱动/后台任务只投递事件，ProductController 串行决定业务状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="event-lane"><mxGeometry x="140" y="705" width="560" height="115" as="geometry"/></mxCell>
        <mxCell id="event-output" value="&lt;b&gt;主任务输出&lt;/b&gt;&lt;br&gt;Display / Led / Feedback、Protocol 命令、AudioService 控制&lt;br&gt;耗时网络、文件和 I²C 操作必须交给服务任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="event-lane"><mxGeometry x="140" y="870" width="560" height="105" as="geometry"/></mxCell>
        <mxCell id="event-gate" value="&lt;b&gt;并发门禁&lt;/b&gt;&lt;br&gt;不在回调里直接改 UI/产品状态；不阻塞 main/audio；所有队列有容量和指标&lt;br&gt;当前 main_tasks_ 为无界 deque，是 PH2 需要显式治理的现有风险" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="event-lane"><mxGeometry x="140" y="1020" width="560" height="105" as="geometry"/></mxCell>

        <mxCell id="task-lane" value="后台任务与数据任务" style="swimlane;horizontal=0;startSize=110;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1380" y="100" width="760" height="1180" as="geometry"/></mxCell>
        <mxCell id="task-audio-in" value="&lt;b&gt;audio_input&lt;/b&gt;&lt;br&gt;优先级 8；C6 栈 4096&lt;br&gt;AudioCodec::InputData → LiteAudioEngine&lt;br&gt;采集任务不能写文件/发网络" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="task-lane"><mxGeometry x="140" y="45" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="task-opus" value="&lt;b&gt;opus_codec&lt;/b&gt;&lt;br&gt;优先级 2；栈 24576&lt;br&gt;encode/decode FixedQueue&lt;br&gt;send/decode/playback 有界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="task-lane"><mxGeometry x="430" y="45" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="task-audio-out" value="&lt;b&gt;audio_output&lt;/b&gt;&lt;br&gt;优先级 4；C6 栈 2048&lt;br&gt;播放队列 → AudioCodec::OutputData&lt;br&gt;播放排空回调通知主任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="task-lane"><mxGeometry x="140" y="220" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="task-network" value="&lt;b&gt;网络/协议内部任务&lt;/b&gt;&lt;br&gt;Wi-Fi manager / MQTT / WebSocket / HTTP&lt;br&gt;回调只置事件位或 Schedule&lt;br&gt;共享 Protocol 语义需双传输验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="task-lane"><mxGeometry x="430" y="220" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="task-notify" value="&lt;b&gt;notify_http&lt;/b&gt;&lt;br&gt;优先级 2；栈 6144&lt;br&gt;HTTP 拉取媒体 → AudioService 解码队列&lt;br&gt;字幕/完成回调经 Schedule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="task-lane"><mxGeometry x="140" y="395" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="task-timers" value="&lt;b&gt;esp_timer 回调&lt;/b&gt;&lt;br&gt;clock_timer / audio_power_timer&lt;br&gt;wifi connect timer / MQTT reconnect&lt;br&gt;只发通知，不做耗时工作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="task-lane"><mxGeometry x="430" y="395" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="task-recorder" value="&lt;b&gt;计划：recorder_task&lt;/b&gt;&lt;br&gt;固定块池 + 有界写盘队列&lt;br&gt;.part → checkpoint → fsync → 原子完成&lt;br&gt;永不阻塞 audio_input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="task-lane"><mxGeometry x="140" y="580" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="task-housekeeping" value="&lt;b&gt;计划：housekeeping&lt;/b&gt;&lt;br&gt;BAT ADC / NFC / IMU 低频轮询&lt;br&gt;能力健康与资源指标&lt;br&gt;有超时、退避和取消" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="task-lane"><mxGeometry x="430" y="580" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="task-ui" value="&lt;b&gt;LVGL/显示上下文&lt;/b&gt;&lt;br&gt;局部缓冲；DisplayLockGuard&lt;br&gt;只渲染状态，不拥有业务真值&lt;br&gt;当前 YaKa 仍为 NoDisplay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="task-lane"><mxGeometry x="140" y="770" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="task-metrics" value="&lt;b&gt;资源观测&lt;/b&gt;&lt;br&gt;heap min / largest block / stack high-water&lt;br&gt;queue peak / drop / audio underrun&lt;br&gt;PH4 进入 CI 门禁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="task-lane"><mxGeometry x="430" y="770" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="task-rule" value="&lt;b&gt;C6 无 PSRAM结论&lt;/b&gt;&lt;br&gt;不能靠大缓存掩盖背压问题；音频、UI、网络、TF 并发必须以内部 SRAM 峰值成立&lt;br&gt;任何计划任务的栈和队列容量均需预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="task-lane"><mxGeometry x="140" y="955" width="540" height="125" as="geometry"/></mxCell>

        <mxCell id="e-boot-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="boot-main" target="boot-board" parent="boot-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-boot-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="boot-board" target="boot-init" parent="boot-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-boot-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="boot-init" target="boot-run" parent="boot-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-run-event" value="wait bits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;" edge="1" source="boot-run" target="event-group" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-event-loop" value="dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;" edge="1" source="event-group" target="event-loop" parent="event-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-schedule-loop" value="MAIN_EVENT_SCHEDULE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;" edge="1" source="schedule" target="event-loop" parent="event-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-state-loop" value="STATE_CHANGED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;" edge="1" source="state-change" target="event-loop" parent="event-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-audio-event" value="send/wake/VAD/drained" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;" edge="1" source="task-audio-in" target="event-group" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-network-event" value="network/protocol callbacks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;" edge="1" source="task-network" target="event-group" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-notify-schedule" value="Schedule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;" edge="1" source="task-notify" target="schedule" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-timer-event" value="event bits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;" edge="1" source="task-timers" target="event-group" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-product-queue-loop" value="计划：固定队列" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;dashed=1;" edge="1" source="product-queue" target="event-loop" parent="event-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-input-recorder" value="PCM 块引用/复制" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;dashed=1;" edge="1" source="task-audio-in" target="task-recorder" parent="task-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-house-product" value="健康/传感事件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;dashed=1;" edge="1" source="task-housekeeping" target="product-queue" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="yaka-data" name="03 音频、录音、UI与OTA数据流">
    <mxGraphModel adaptiveColors="auto" dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="df-title" value="&lt;b&gt;关键数据路径与所有权&lt;/b&gt;&lt;br&gt;展示当前上游链路以及 YaKa 本地录音、产品 UI、OTA 策略的计划接缝" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="430" y="20" width="1340" height="60" as="geometry"/></mxCell>

        <mxCell id="audio-up-lane" value="AI 对话上行（当前可复用）" style="swimlane;horizontal=0;startSize=125;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="2100" height="210" as="geometry"/></mxCell>
        <mxCell id="mic" value="&lt;b&gt;ES7210 双麦 + 播放参考&lt;/b&gt;&lt;br&gt;I²S RX；slot 必须实测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="audio-up-lane"><mxGeometry x="150" y="55" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="codec-in" value="&lt;b&gt;AudioCodec&lt;/b&gt;&lt;br&gt;main/audio/audio_codec.*&lt;br&gt;InputData() / input_channels()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="audio-up-lane"><mxGeometry x="420" y="55" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="input-task" value="&lt;b&gt;AudioInputTask&lt;/b&gt;&lt;br&gt;10 ms PCM；唯一采集所有者&lt;br&gt;main/audio/audio_service.cc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="audio-up-lane"><mxGeometry x="700" y="55" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="lite" value="&lt;b&gt;LiteAudioEngine&lt;/b&gt;&lt;br&gt;main/audio/engines/lite_audio_engine.*&lt;br&gt;多通道只取第一个输入通道；无设备端 AEC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="audio-up-lane"><mxGeometry x="990" y="45" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="opus-up" value="&lt;b&gt;OpusCodecTask&lt;/b&gt;&lt;br&gt;audio_encode_queue_ → audio_send_queue_&lt;br&gt;60 ms Opus / FixedQueue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="audio-up-lane"><mxGeometry x="1330" y="55" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="app-send" value="&lt;b&gt;Application&lt;/b&gt;&lt;br&gt;MAIN_EVENT_SEND_AUDIO&lt;br&gt;PopPacketFromSendQueue()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="audio-up-lane"><mxGeometry x="1650" y="55" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="cloud-up" value="&lt;b&gt;Protocol → 云端&lt;/b&gt;&lt;br&gt;MQTT/UDP 或 WebSocket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="audio-up-lane"><mxGeometry x="1940" y="55" width="140" height="90" as="geometry"/></mxCell>

        <mxCell id="audio-down-lane" value="AI 对话下行（当前可复用）" style="swimlane;horizontal=0;startSize=125;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="2100" height="190" as="geometry"/></mxCell>
        <mxCell id="cloud-down" value="&lt;b&gt;云端 TTS Opus&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="audio-down-lane"><mxGeometry x="160" y="55" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="protocol-down" value="&lt;b&gt;Protocol::OnIncomingAudio&lt;/b&gt;&lt;br&gt;仅 speaking 状态接收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="audio-down-lane"><mxGeometry x="400" y="45" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="decode" value="&lt;b&gt;decode queue → OpusCodecTask&lt;/b&gt;&lt;br&gt;有界解码与播放队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="audio-down-lane"><mxGeometry x="710" y="45" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="output-task" value="&lt;b&gt;AudioOutputTask&lt;/b&gt;&lt;br&gt;播放进度 / drained 回调" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="audio-down-lane"><mxGeometry x="1020" y="45" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="codec-out" value="&lt;b&gt;AudioCodec::OutputData&lt;/b&gt;&lt;br&gt;计划：ES8311 + PA_EN 时序" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="audio-down-lane"><mxGeometry x="1330" y="45" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="speaker" value="&lt;b&gt;HT8691R → Speaker&lt;/b&gt;&lt;br&gt;停播先关 PA；爆音/失真实测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="audio-down-lane"><mxGeometry x="1660" y="45" width="270" height="95" as="geometry"/></mxCell>

        <mxCell id="record-lane" value="本地录音（PH3 计划，I²S RX 不得出现第二个读取者）" style="swimlane;horizontal=0;startSize=125;rounded=1;html=1;fillColor=#FFF7E6;strokeColor=#D79B00;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="2100" height="230" as="geometry"/></mxCell>
        <mxCell id="capture-adapter" value="&lt;b&gt;CaptureAdapter&lt;/b&gt;&lt;br&gt;计划：main/yaka/audio_capture_adapter.*&lt;br&gt;在唯一采集路径非阻塞分流；固定块池" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="record-lane"><mxGeometry x="180" y="55" width="310" height="110" as="geometry"/></mxCell>
        <mxCell id="record-queue" value="&lt;b&gt;有界 RecorderQueue&lt;/b&gt;&lt;br&gt;满载：计数 + 明确停止/降级&lt;br&gt;禁止阻塞 I²S DMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="record-lane"><mxGeometry x="550" y="55" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="recorder" value="&lt;b&gt;RecorderService / recorder_task&lt;/b&gt;&lt;br&gt;main/yaka/recorder_service.*&lt;br&gt;容器化、checkpoint、错误状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="record-lane"><mxGeometry x="890" y="55" width="310" height="110" as="geometry"/></mxCell>
        <mxCell id="storage" value="&lt;b&gt;StorageService&lt;/b&gt;&lt;br&gt;main/yaka/storage_service.*&lt;br&gt;挂载、容量、索引、临时文件、原子提交" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="record-lane"><mxGeometry x="1260" y="55" width="310" height="110" as="geometry"/></mxCell>
        <mxCell id="tf" value="&lt;b&gt;TF / FatFS / SDSPI&lt;/b&gt;&lt;br&gt;GPIO15/18/19/20；无 card-detect&lt;br&gt;.part → fsync → rename → 文件索引" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="record-lane"><mxGeometry x="1630" y="55" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="power-cut" value="&lt;b&gt;MASTER_SW 硬切&lt;/b&gt;&lt;br&gt;启动恢复/半文件识别&lt;br&gt;随机掉电必须实板验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="record-lane"><mxGeometry x="2000" y="55" width="80" height="110" as="geometry"/></mxCell>

        <mxCell id="ui-lane" value="输入、产品状态与反馈（PH2/PH3 计划）" style="swimlane;horizontal=0;startSize=125;rounded=1;html=1;fillColor=#FFF7E6;strokeColor=#D79B00;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="2100" height="220" as="geometry"/></mxCell>
        <mxCell id="hw-input" value="&lt;b&gt;DPAD ADC + GPIO 键&lt;/b&gt;&lt;br&gt;Button / AdcButton；阈值待实板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="ui-lane"><mxGeometry x="160" y="55" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="input-service" value="&lt;b&gt;InputService&lt;/b&gt;&lt;br&gt;物理键 → 去抖/长按 → 规范事件&lt;br&gt;不包含页面语义" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="ui-lane"><mxGeometry x="480" y="55" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="pc-ui" value="&lt;b&gt;ProductController&lt;/b&gt;&lt;br&gt;需求状态与动作门禁&lt;br&gt;CapabilityHealth 决定可用/降级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="ui-lane"><mxGeometry x="820" y="55" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="feedback" value="&lt;b&gt;FeedbackService&lt;/b&gt;&lt;br&gt;统一优先级、互斥和持续状态&lt;br&gt;页面 / RGB / 灯阵 / 振动 / 提示音" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="ui-lane"><mxGeometry x="1170" y="55" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="display-ui" value="&lt;b&gt;ST7789 200×320 / LVGL&lt;/b&gt;&lt;br&gt;display/lcd_display.* + YaKa 页面&lt;br&gt;局部缓冲；禁止默认双全屏缓冲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="ui-lane"><mxGeometry x="1540" y="45" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="aux-feedback" value="&lt;b&gt;RGB / 五灯 / ERM / 声音&lt;/b&gt;&lt;br&gt;状态补充，不代替必要文本&lt;br&gt;上电默认关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="ui-lane"><mxGeometry x="1920" y="45" width="160" height="120" as="geometry"/></mxCell>

        <mxCell id="ota-lane" value="OTA、配置与恢复" style="swimlane;horizontal=0;startSize=125;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="2100" height="260" as="geometry"/></mxCell>
        <mxCell id="ota-config" value="&lt;b&gt;Ota / Settings / Assets（当前）&lt;/b&gt;&lt;br&gt;main/ota.* / settings.* / assets.*&lt;br&gt;检查版本、HTTP 下载、NVS、资源分区" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ota-lane"><mxGeometry x="160" y="55" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="update-service" value="&lt;b&gt;UpdateService（计划）&lt;/b&gt;&lt;br&gt;用户确认 / 电量与任务门限&lt;br&gt;产品+硬件 revision+最低版本兼容&lt;br&gt;升级期间与录音/提交互斥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="ota-lane"><mxGeometry x="570" y="45" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="partition" value="&lt;b&gt;16 MiB 分区&lt;/b&gt;&lt;br&gt;partitions/v2/16m_c3.csv&lt;br&gt;nvs 16 KiB / otadata 8 KiB&lt;br&gt;ota_0 + ota_1 各 4032 KiB / assets 4000 KiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ota-lane"><mxGeometry x="1010" y="45" width="370" height="140" as="geometry"/></mxCell>
        <mxCell id="bootloader" value="&lt;b&gt;Bootloader rollback&lt;/b&gt;&lt;br&gt;CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE&lt;br&gt;新固件自检、确认、未确认回滚&lt;br&gt;真实掉电/启动失败待实板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ota-lane"><mxGeometry x="1440" y="45" width="350" height="140" as="geometry"/></mxCell>
        <mxCell id="ota-gate" value="&lt;b&gt;发布门禁&lt;/b&gt;&lt;br&gt;签名/校验、包哈希、Git SHA、SDK、分区、硬件版本&lt;br&gt;坏包/断网/低电/硬切/回滚证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="ota-lane"><mxGeometry x="1850" y="55" width="230" height="120" as="geometry"/></mxCell>

        <mxCell id="e-up-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="mic" target="codec-in" parent="audio-up-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-up-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="codec-in" target="input-task" parent="audio-up-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-up-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="input-task" target="lite" parent="audio-up-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-up-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="lite" target="opus-up" parent="audio-up-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-up-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="opus-up" target="app-send" parent="audio-up-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-up-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="app-send" target="cloud-up" parent="audio-up-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-down-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="cloud-down" target="protocol-down" parent="audio-down-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-down-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="protocol-down" target="decode" parent="audio-down-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-down-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="decode" target="output-task" parent="audio-down-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-down-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="output-task" target="codec-out" parent="audio-down-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-down-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="codec-out" target="speaker" parent="audio-down-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-capture" value="非阻塞分流" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;dashed=1;" edge="1" source="input-task" target="capture-adapter" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-rec-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" source="capture-adapter" target="record-queue" parent="record-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-rec-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" source="record-queue" target="recorder" parent="record-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-rec-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" source="recorder" target="storage" parent="record-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-rec-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" source="storage" target="tf" parent="record-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ui-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" source="hw-input" target="input-service" parent="ui-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ui-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" source="input-service" target="pc-ui" parent="ui-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ui-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" source="pc-ui" target="feedback" parent="ui-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ui-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" source="feedback" target="display-ui" parent="ui-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ui-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" source="feedback" target="aux-feedback" parent="ui-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ota-1" value="transport/config" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;dashed=1;" edge="1" source="ota-config" target="update-service" parent="ota-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ota-2" value="写 inactive slot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;dashed=1;" edge="1" source="update-service" target="partition" parent="ota-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ota-3" value="启动确认/回滚" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;dashed=1;" edge="1" source="partition" target="bootloader" parent="ota-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="yaka-build" name="04 构建、上游、CI与文档同步">
    <mxGraphModel adaptiveColors="auto" dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bd-title" value="&lt;b&gt;构建选择链、上游同步、CI 与三端文档治理&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="480" y="20" width="1240" height="60" as="geometry"/></mxCell>

        <mxCell id="build-lane" value="唯一板型构建选择链" style="swimlane;horizontal=0;startSize=125;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="2100" height="310" as="geometry"/></mxCell>
        <mxCell id="build-command" value="&lt;b&gt;构建入口&lt;/b&gt;&lt;br&gt;python scripts/build.py&lt;br&gt;chatchat/hi-yaka-v3 --name hi-yaka-v3&lt;br&gt;--language zh-CN --wake-word disabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="build-lane"><mxGeometry x="160" y="50" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="config-json" value="&lt;b&gt;board config.json&lt;/b&gt;&lt;br&gt;target=esp32c6&lt;br&gt;DIO / wake word off / device AEC off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="build-lane"><mxGeometry x="500" y="50" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="sdkconfig" value="&lt;b&gt;sdkconfig defaults 合并&lt;/b&gt;&lt;br&gt;sdkconfig.defaults&lt;br&gt;sdkconfig.defaults.esp32c6&lt;br&gt;board sdkconfig_append&lt;br&gt;最终：16 MiB / 16m_c3.csv / DIO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="build-lane"><mxGeometry x="810" y="40" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="kconfig" value="&lt;b&gt;Kconfig 选择&lt;/b&gt;&lt;br&gt;main/Kconfig.projbuild&lt;br&gt;BOARD_TYPE_HI_YAKA_V3&lt;br&gt;depends on IDF_TARGET_ESP32C6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="build-lane"><mxGeometry x="1150" y="50" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="cmake" value="&lt;b&gt;CMake 源选择&lt;/b&gt;&lt;br&gt;main/CMakeLists.txt&lt;br&gt;BOARD_DIR=chatchat/hi-yaka-v3&lt;br&gt;字体、图标、AudioEngine、依赖组件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="build-lane"><mxGeometry x="1480" y="50" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="factory" value="&lt;b&gt;单一 Board Factory&lt;/b&gt;&lt;br&gt;hi_yaka_v3_board.cc&lt;br&gt;DECLARE_BOARD(HiYakaV3Board)&lt;br&gt;每个固件只能有一个工厂" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="build-lane"><mxGeometry x="1820" y="50" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="partition-build" value="&lt;b&gt;分区与资源&lt;/b&gt;&lt;br&gt;partitions/v2/16m_c3.csv&lt;br&gt;assets pipeline / fonts / locale / SPIFFS image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="build-lane"><mxGeometry x="690" y="210" width="310" height="75" as="geometry"/></mxCell>
        <mxCell id="artifacts" value="&lt;b&gt;可追溯产物&lt;/b&gt;&lt;br&gt;bootloader.bin / partition-table.bin / xiaozhi.bin / assets.bin / merged image&lt;br&gt;版本、上游 SHA、SDK、sdkconfig、分区与 SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="build-lane"><mxGeometry x="1090" y="205" width="500" height="85" as="geometry"/></mxCell>

        <mxCell id="repo-lane" value="仓库与上游策略" style="swimlane;horizontal=0;startSize=125;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1010" height="430" as="geometry"/></mxCell>
        <mxCell id="upstream" value="&lt;b&gt;upstream：78/xiaozhi-esp32&lt;/b&gt;&lt;br&gt;只拉取；当前固定 v2.5.2 / 49b4380&lt;br&gt;不追随 upstream/main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="repo-lane"><mxGeometry x="150" y="50" width="350" height="105" as="geometry"/></mxCell>
        <mxCell id="private" value="&lt;b&gt;origin：njueeRay/hi-yaka-firmware&lt;/b&gt;&lt;br&gt;私有开发真值；完整历史、PR、CI、内部文档&lt;br&gt;main / feature/* / sync/xiaozhi-vX.Y.Z" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="repo-lane"><mxGeometry x="560" y="50" width="370" height="105" as="geometry"/></mxCell>
        <mxCell id="sync-branch" value="&lt;b&gt;独立上游同步 PR&lt;/b&gt;&lt;br&gt;git fetch upstream --tags → sync 分支 → merge release tag&lt;br&gt;不混入产品功能；构建 YaKa C6 + 上游 C6 代表板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="repo-lane"><mxGeometry x="150" y="205" width="780" height="90" as="geometry"/></mxCell>
        <mxCell id="public" value="&lt;b&gt;公开快照：ChatChatTech/yaka/firmware&lt;/b&gt;&lt;br&gt;只发布审查后的受控快照；不镜像私有历史/内部 PRD/凭据&lt;br&gt;记录私有来源 SHA、上游 SHA、SDK、验证等级与排除范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="repo-lane"><mxGeometry x="150" y="335" width="780" height="80" as="geometry"/></mxCell>

        <mxCell id="ci-lane" value="CI、Raynode 与验证等级" style="swimlane;horizontal=0;startSize=125;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="440" width="1060" height="430" as="geometry"/></mxCell>
        <mxCell id="ci-contract" value="&lt;b&gt;YaKa board contract&lt;/b&gt;&lt;br&gt;.github/workflows/yaka-contract.yml&lt;br&gt;scripts/tests/test_hi_yaka_board.py&lt;br&gt;板型、选择链、无 PSRAM、PCA 顺序、未启用外设" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="ci-lane"><mxGeometry x="150" y="45" width="370" height="125" as="geometry"/></mxCell>
        <mxCell id="ci-upstream" value="&lt;b&gt;上游 CI/host tests&lt;/b&gt;&lt;br&gt;.github/workflows/build.yml&lt;br&gt;python -m unittest discover -s scripts/tests -v&lt;br&gt;代表 target / network / assets / release 检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ci-lane"><mxGeometry x="570" y="45" width="350" height="125" as="geometry"/></mxCell>
        <mxCell id="raynode" value="&lt;b&gt;Raynode 可复现构建&lt;/b&gt;&lt;br&gt;/srv/projects/hi-yaka-firmware&lt;br&gt;espressif/idf:v6.1 固定 digest&lt;br&gt;远程构建、产物与日志" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ci-lane"><mxGeometry x="150" y="215" width="350" height="115" as="geometry"/></mxCell>
        <mxCell id="evidence" value="&lt;b&gt;证据等级&lt;/b&gt;&lt;br&gt;L0：静态/host/build/hash&lt;br&gt;L1：实板启动/总线/驱动&lt;br&gt;L2：功能/故障注入/重复性&lt;br&gt;L3：整机场景/功耗/声学/长稳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="ci-lane"><mxGeometry x="550" y="205" width="370" height="135" as="geometry"/></mxCell>
        <mxCell id="ci-gate" value="PH0–PH5 只能关闭 L0 项；M1–M7 涉及物理行为的 checklist 必须等待 L1–L3。构建成功、模拟成功和驱动返回成功都不能写成实板通过。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="ci-lane"><mxGeometry x="150" y="360" width="770" height="55" as="geometry"/></mxCell>

        <mxCell id="docs-lane" value="本地 → GitHub → 飞书的文档同步" style="swimlane;horizontal=0;startSize=125;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="2100" height="390" as="geometry"/></mxCell>
        <mxCell id="doc-product" value="&lt;b&gt;产品 PRD&lt;/b&gt;&lt;br&gt;.agents/skills/yaka-project/references/&lt;br&gt;yaka-3.0-prd.md&lt;br&gt;用户/场景/范围/交互/产品验收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="docs-lane"><mxGeometry x="150" y="45" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="doc-firmware" value="&lt;b&gt;固件 PRD 与里程碑&lt;/b&gt;&lt;br&gt;docs/governance/FIRMWARE_PRD.md&lt;br&gt;YFWR、PH0–PH5、M1–M7、DoD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="docs-lane"><mxGeometry x="550" y="45" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="doc-interface" value="&lt;b&gt;硬件连接与接口表&lt;/b&gt;&lt;br&gt;docs/hardware/HARDWARE_MODULE_INTERFACES.md&lt;br&gt;GPIO / 总线 / 地址 / 极性 / 初始化 / 首板矩阵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="docs-lane"><mxGeometry x="950" y="45" width="370" height="120" as="geometry"/></mxCell>
