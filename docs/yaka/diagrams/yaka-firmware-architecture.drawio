        <mxCell id="product-controller" value="&lt;b&gt;ProductController（计划）&lt;/b&gt;&lt;br&gt;main/yaka/product_controller.*&lt;br&gt;唯一产品状态写入者&lt;br&gt;PowerPhase / ForegroundMode / Connectivity / CapabilityHealth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="lane-control"><mxGeometry x="930" y="35" width="380" height="150" as="geometry"/></mxCell>
