        <mxCell id="yaka-board" value="&lt;b&gt;HiYakaV3Board（M1 软件骨架）&lt;/b&gt;&lt;br&gt;main/boards/chatchat/hi-yaka-v3/&lt;br&gt;hi_yaka_v3_board.cc / config.h / config.json&lt;br&gt;启动诊断、I²C 探测、PCA9557 安全态&lt;br&gt;当前：DummyAudioCodec + NoDisplay + NoLed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lane-bsp"><mxGeometry x="560" y="30" width="430" height="150" as="geometry"/></mxCell>
        <mxCell id="yaka-drivers" value="&lt;b&gt;YaKa 驱动接入（计划）&lt;/b&gt;&lt;br&gt;ST7789 / ADC DPAD / ES7210 + ES8311&lt;br&gt;TF(SDSPI) / PN532 / QMI8658A&lt;br&gt;RGB / 五灯阵 / ERM / BAT ADC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="lane-bsp"><mxGeometry x="1040" y="40" width="390" height="130" as="geometry"/></mxCell>
        <mxCell id="health" value="&lt;b&gt;Capability Registry（计划）&lt;/b&gt;&lt;br&gt;unavailable / initializing / ready&lt;br&gt;degraded / failed&lt;br&gt;驱动结果 → 诊断/UI/动作门禁同一来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="lane-bsp"><mxGeometry x="1480" y="40" width="360" height="130" as="geometry"/></mxCell>
        <mxCell id="bsp-gate" value="&lt;b&gt;实板证据门禁&lt;/b&gt;&lt;br&gt;L0 构建 ≠ L1 启动&lt;br&gt;驱动成功 ≠ L2 功能闭环&lt;br&gt;发布必须 L3 场景/长稳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="lane-bsp"><mxGeometry x="1870" y="45" width="180" height="120" as="geometry"/></mxCell>

        <mxCell id="lane-hw" value="ESP-IDF 6.1 与 YaKa 3.0 硬件" style="swimlane;horizontal=0;startSize=130;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="2100" height="230" as="geometry"/></mxCell>
        <mxCell id="idf" value="&lt;b&gt;ESP-IDF / FreeRTOS&lt;/b&gt;&lt;br&gt;任务、EventGroup、I²C、I²S、SPI、SDSPI&lt;br&gt;NVS、OTA、HTTP、Wi-Fi、RMT、ADC、LVGL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="lane-hw"><mxGeometry x="160" y="45" width="370" height="110" as="geometry"/></mxCell>
        <mxCell id="soc" value="&lt;b&gt;ESP32-C6&lt;/b&gt;&lt;br&gt;16 MiB DIO Flash / 无 PSRAM&lt;br&gt;内部 SRAM 必须有预算和峰值门禁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="lane-hw"><mxGeometry x="580" y="45" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="i2c-hw" value="&lt;b&gt;共享 I²C0 GPIO10/11&lt;/b&gt;&lt;br&gt;ES8311 0x18 / PCA9557 0x19&lt;br&gt;PN532 0x24 / ES7210 0x41 / QMI8658A 0x6A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="lane-hw"><mxGeometry x="930" y="35" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="spi-hw" value="&lt;b&gt;SPI / I²S / GPIO&lt;/b&gt;&lt;br&gt;ST7789 200×320 / TF SDSPI&lt;br&gt;双麦 + 播放参考 / PA + Speaker&lt;br&gt;DPAD / RGB / 灯阵 / 马达 / BAT ADC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="lane-hw"><mxGeometry x="1360" y="35" width="390" height="130" as="geometry"/></mxCell>
        <mxCell id="power-hw" value="&lt;b&gt;电源边界&lt;/b&gt;&lt;br&gt;MASTER_SW 可任意硬切&lt;br&gt;文件、NVS、OTA 必须恢复&lt;br&gt;MCU 不可可靠观测完整充电终态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="lane-hw"><mxGeometry x="1800" y="40" width="250" height="120" as="geometry"/></mxCell>

