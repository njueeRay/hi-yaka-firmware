  <diagram id="yaka-build" name="04 构建、上游、CI与文档同步">
    <mxGraphModel adaptiveColors="auto" dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bd-title" value="&lt;b&gt;构建选择链、上游同步、CI 与三端文档治理&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="480" y="20" width="1240" height="60" as="geometry"/></mxCell>
        <mxCell id="bd-legend-title" value="&lt;b&gt;统一图例&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1325" width="90" height="45" as="geometry"/></mxCell>
        <mxCell id="bd-legend-blue" value="蓝：小智/上游现有实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="140" y="1325" width="235" height="45" as="geometry"/></mxCell>
        <mxCell id="bd-legend-green" value="绿：HiYaKa 本地已实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="385" y="1325" width="220" height="45" as="geometry"/></mxCell>
        <mxCell id="bd-legend-orange" value="橙虚线：待批准/待实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="615" y="1325" width="230" height="45" as="geometry"/></mxCell>
        <mxCell id="bd-legend-yellow" value="黄：已确认合同/配置/产物" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="855" y="1325" width="235" height="45" as="geometry"/></mxCell>
        <mxCell id="bd-legend-purple" value="紫：外部系统/发布/协作副本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="1325" width="235" height="45" as="geometry"/></mxCell>
        <mxCell id="bd-legend-gray" value="灰：物理对象/上下文/容器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1345" y="1325" width="220" height="45" as="geometry"/></mxCell>
        <mxCell id="bd-legend-red" value="红：约束/风险/门禁/证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1575" y="1325" width="225" height="45" as="geometry"/></mxCell>
        <mxCell id="bd-legend-line" value="线型：实线=当前/已确认；虚线=计划关系" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1810" y="1325" width="330" height="45" as="geometry"/></mxCell>

        <mxCell id="build-lane" value="唯一板型构建选择链" style="swimlane;horizontal=0;startSize=125;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="2100" height="310" as="geometry"/></mxCell>
        <mxCell id="build-command" value="&lt;b&gt;ChatChat HiYaKa 构建入口&lt;/b&gt;&lt;br&gt;python scripts/build.py&lt;br&gt;安全产物：hi-yaka&lt;br&gt;全适配编译：hi-yaka-lab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="build-lane"><mxGeometry x="160" y="50" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="config-json" value="&lt;b&gt;board config.json&lt;/b&gt;&lt;br&gt;target=esp32c6 / DIO / 无 PSRAM&lt;br&gt;8 个 HI_YAKA_ENABLE_* 分模块开关&lt;br&gt;默认全部关闭，lab 全部开启" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="build-lane"><mxGeometry x="500" y="50" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="sdkconfig" value="&lt;b&gt;sdkconfig defaults 合并&lt;/b&gt;&lt;br&gt;sdkconfig.defaults&lt;br&gt;sdkconfig.defaults.esp32c6&lt;br&gt;board sdkconfig_append&lt;br&gt;最终：16 MiB / hi-yaka-16m.csv / DIO / rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="build-lane"><mxGeometry x="810" y="40" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="kconfig" value="&lt;b&gt;Kconfig 选择&lt;/b&gt;&lt;br&gt;main/Kconfig.projbuild&lt;br&gt;宏：BOARD_TYPE_HI_YAKA&lt;br&gt;depends on IDF_TARGET_ESP32C6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="build-lane"><mxGeometry x="1150" y="50" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="cmake" value="&lt;b&gt;CMake 源选择&lt;/b&gt;&lt;br&gt;main/CMakeLists.txt&lt;br&gt;BOARD_DIR=chatchat/hi-yaka&lt;br&gt;字体、图标、AudioEngine、依赖组件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="build-lane"><mxGeometry x="1480" y="50" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="factory" value="&lt;b&gt;HiYaKa 单一 Board Factory&lt;/b&gt;&lt;br&gt;文件：hi_yaka_board.cc&lt;br&gt;类：HiYaKaBoard&lt;br&gt;每个固件只能有一个工厂" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="build-lane"><mxGeometry x="1820" y="50" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="partition-build" value="&lt;b&gt;分区与资源门禁（已实现）&lt;/b&gt;&lt;br&gt;hi-yaka-16m.csv / app 上限 / RAM≤90%&lt;br&gt;录音队列 12 块 / 产品层新增 task=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="build-lane"><mxGeometry x="690" y="210" width="310" height="75" as="geometry"/></mxCell>
        <mxCell id="artifacts" value="&lt;b&gt;可追溯候选产物（已实现）&lt;/b&gt;&lt;br&gt;app / merged image / size / resource / provenance / sdkconfig / partition&lt;br&gt;源码 SHA、上游 SHA、SDK、CI run 与 SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="build-lane"><mxGeometry x="1090" y="205" width="500" height="85" as="geometry"/></mxCell>

        <mxCell id="repo-lane" value="仓库与上游策略" style="swimlane;horizontal=0;startSize=125;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1010" height="430" as="geometry"/></mxCell>
        <mxCell id="upstream" value="&lt;b&gt;upstream：78/xiaozhi-esp32&lt;/b&gt;&lt;br&gt;只拉取；当前固定 v2.5.2 / 49b4380&lt;br&gt;不追随 upstream/main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="repo-lane"><mxGeometry x="150" y="50" width="350" height="105" as="geometry"/></mxCell>
        <mxCell id="private" value="&lt;b&gt;origin：njueeRay/hi-yaka-firmware&lt;/b&gt;&lt;br&gt;私有开发真值；完整历史、PR、CI、内部文档&lt;br&gt;main / feature/* / sync/xiaozhi-vX.Y.Z" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="repo-lane"><mxGeometry x="560" y="50" width="370" height="105" as="geometry"/></mxCell>
        <mxCell id="sync-branch" value="&lt;b&gt;独立上游同步 PR&lt;/b&gt;&lt;br&gt;git fetch upstream --tags → sync 分支 → merge release tag&lt;br&gt;不混入产品功能；构建 HiYaKa C6 + 上游 C6 代表板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="repo-lane"><mxGeometry x="150" y="205" width="780" height="90" as="geometry"/></mxCell>
        <mxCell id="public" value="&lt;b&gt;公开快照：ChatChatTech/yaka/firmware&lt;/b&gt;&lt;br&gt;只发布审查后的受控快照；不镜像私有历史/内部 PRD/凭据&lt;br&gt;记录私有来源 SHA、上游 SHA、SDK、验证等级与排除范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="repo-lane"><mxGeometry x="150" y="335" width="780" height="80" as="geometry"/></mxCell>

        <mxCell id="ci-lane" value="CI、aliyun_raynode 与验证等级" style="swimlane;horizontal=0;startSize=125;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="440" width="1060" height="430" as="geometry"/></mxCell>
        <mxCell id="ci-contract" value="&lt;b&gt;HiYaKa 产品门禁&lt;/b&gt;&lt;br&gt;yaka-contract + yaka-product-core&lt;br&gt;board / host / IDF 6.1 build&lt;br&gt;分区、资源、OTA、追溯与候选产物" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="ci-lane"><mxGeometry x="150" y="45" width="370" height="125" as="geometry"/></mxCell>
        <mxCell id="ci-upstream" value="&lt;b&gt;上游 CI/host tests&lt;/b&gt;&lt;br&gt;.github/workflows/build.yml&lt;br&gt;python -m unittest discover -s scripts/tests -v&lt;br&gt;代表 target / network / assets / release 检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ci-lane"><mxGeometry x="570" y="45" width="350" height="125" as="geometry"/></mxCell>
        <mxCell id="aliyun_raynode" value="&lt;b&gt;aliyun_raynode 可复现构建&lt;/b&gt;&lt;br&gt;/srv/projects/hi-yaka-firmware&lt;br&gt;espressif/idf:v6.1 固定 digest&lt;br&gt;远程构建、产物与日志" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ci-lane"><mxGeometry x="150" y="215" width="350" height="115" as="geometry"/></mxCell>
        <mxCell id="evidence" value="&lt;b&gt;证据等级&lt;/b&gt;&lt;br&gt;L0：静态/host/build/hash&lt;br&gt;L1：实板启动/总线/驱动&lt;br&gt;L2：功能/故障注入/重复性&lt;br&gt;L3：整机场景/功耗/声学/长稳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="ci-lane"><mxGeometry x="550" y="205" width="370" height="135" as="geometry"/></mxCell>
        <mxCell id="ci-gate" value="PH0–PH5 只能关闭 L0 项；M1–M7 涉及物理行为的 checklist 必须等待 L1–L3。构建成功、模拟成功和驱动返回成功都不能写成实板通过。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="ci-lane"><mxGeometry x="150" y="360" width="770" height="55" as="geometry"/></mxCell>

        <mxCell id="docs-lane" value="本地 → GitHub → 飞书的文档同步" style="swimlane;horizontal=0;startSize=125;rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="2100" height="390" as="geometry"/></mxCell>
        <mxCell id="doc-product" value="&lt;b&gt;HiYaKa 产品 PRD&lt;/b&gt;&lt;br&gt;项目 skill reference&lt;br&gt;用户/场景/范围/交互/产品验收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="docs-lane"><mxGeometry x="150" y="45" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="doc-firmware" value="&lt;b&gt;固件 PRD 与里程碑&lt;/b&gt;&lt;br&gt;docs/governance/FIRMWARE_PRD.md&lt;br&gt;YFWR、PH0–PH5、M1–M7、DoD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="docs-lane"><mxGeometry x="550" y="45" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="doc-interface" value="&lt;b&gt;硬件连接与接口表&lt;/b&gt;&lt;br&gt;docs/hardware/HARDWARE_MODULE_INTERFACES.md&lt;br&gt;GPIO / 总线 / 地址 / 极性 / 初始化 / 首板矩阵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="docs-lane"><mxGeometry x="950" y="45" width="370" height="120" as="geometry"/></mxCell>
        <mxCell id="doc-architecture" value="&lt;b&gt;架构图与说明&lt;/b&gt;&lt;br&gt;docs/yaka/firmware-architecture.md&lt;br&gt;docs/yaka/diagrams/yaka-firmware-architecture.drawio&lt;br&gt;代码层、运行时、数据流、构建治理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="docs-lane"><mxGeometry x="1370" y="45" width="390" height="120" as="geometry"/></mxCell>
        <mxCell id="doc-registry" value="&lt;b&gt;同步登记&lt;/b&gt;&lt;br&gt;docs/governance/FEISHU_SYNC_REGISTRY.md&lt;br&gt;token / revision / hash / 差异状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="docs-lane"><mxGeometry x="1810" y="45" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="github-docs" value="&lt;b&gt;GitHub 私有仓库&lt;/b&gt;&lt;br&gt;docs/README.md 提供三份核心文档阅读顺序&lt;br&gt;提交 SHA 是本地 Markdown 版本身份" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="docs-lane"><mxGeometry x="330" y="225" width="500" height="95" as="geometry"/></mxCell>
        <mxCell id="feishu-docs" value="&lt;b&gt;飞书协作副本&lt;/b&gt;&lt;br&gt;01 产品需求与交互状态 / 01 固件 PRD 与里程碑&lt;br&gt;03 硬件连接与固件接口表 / 硬件主文档附件入口&lt;br&gt;同步后必须回读关键章节和 revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="docs-lane"><mxGeometry x="910" y="215" width="600" height="110" as="geometry"/></mxCell>
        <mxCell id="doc-rule" value="&lt;b&gt;阶段关闭规则&lt;/b&gt;&lt;br&gt;代码/文档/证据 → 本地 checklist → GitHub 推送 → 飞书同步 → revision 回写&lt;br&gt;任一步缺失都不能把阶段标为已完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="docs-lane"><mxGeometry x="1590" y="215" width="490" height="110" as="geometry"/></mxCell>

