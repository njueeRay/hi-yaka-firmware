        <mxCell id="e-up-private" value="merge release tag" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;endArrow=block;" edge="1" source="upstream" target="private" parent="repo-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
